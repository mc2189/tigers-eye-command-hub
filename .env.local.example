# Cliniko test/sandbox configuration only. Never commit a real key.
CLINIKO_API_KEY=
# Must match the shard suffix on your API key (for example uk3). If omitted, infer from the key.
CLINIKO_SHARD=uk3
CLINIKO_USER_AGENT=Tigers Eye Command Hub Demo / portfolio project
# Keep writes disabled by default; enable only in an authorised sandbox/test environment.
CLINIKO_ENABLE_WRITES=false
NEXT_PUBLIC_DEMO_MODE=true

# Demo staff gate for /admin and /api/cliniko/*
# Generate long random values locally/deployment-side.
DEMO_STAFF_PASSWORD=
DEMO_SESSION_SECRET=

# Command Hub durable workflow storage - server only (see docs/WORKFLOW_STORAGE.md)
COMMAND_HUB_WORKFLOW_STORAGE=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
COMMAND_HUB_SUPABASE_TABLE=command_hub_workflow_state
COMMAND_HUB_WORKFLOW_STORE_ID=tigers-eye-demo

# Vercel KV durable option
KV_REST_API_URL=
KV_REST_API_TOKEN=
COMMAND_HUB_WORKFLOW_KV_KEY=tigers-eye-command-hub-workflow-state

# Vercel Blob durable option
BLOB_READ_WRITE_TOKEN=
COMMAND_HUB_WORKFLOW_BLOB_PATH=tigers-eye-command-hub-workflow-state.json
