CLINIKO_API_KEY=your-sandbox-key-here
# Must match the shard suffix on your API key (e.g. ...-uk3 → uk3). If omitted, inferred from the key.
CLINIKO_SHARD=uk3
CLINIKO_USER_AGENT=Tigers Eye Command Hub Demo / built by Mike Currie
CLINIKO_ENABLE_WRITES=true
NEXT_PUBLIC_DEMO_MODE=true

# Demo staff gate for /admin and /api/cliniko/*
# Generate a long random string for DEMO_SESSION_SECRET (never commit real values)
DEMO_STAFF_PASSWORD=change-me-before-deploy
DEMO_SESSION_SECRET=change-me-use-long-random-string

# Supabase/Postgres durable option (see docs/WORKFLOW_STORAGE.md for table SQL)
# Set COMMAND_HUB_WORKFLOW_STORAGE=supabase when credentials are ready
COMMAND_HUB_WORKFLOW_STORAGE=auto
# Optional override for local file path (dev only)
# COMMAND_HUB_WORKFLOW_STATE_PATH=

# Supabase/Postgres durable option (see docs/WORKFLOW_STORAGE.md for table SQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMMAND_HUB_SUPABASE_TABLE=command_hub_workflow_state
COMMAND_HUB_WORKFLOW_STORE_ID=tigers-eye-demo

# Vercel KV durable option (Upstash REST credentials from Vercel KV integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
COMMAND_HUB_WORKFLOW_KV_KEY=tigers-eye-command-hub-workflow-state

# Vercel Blob durable option
BLOB_READ_WRITE_TOKEN=
COMMAND_HUB_WORKFLOW_BLOB_PATH=tigers-eye-command-hub-workflow-state.json
